###############################################################################
# 5. MITIGATION - Manual IP Blocking
###############################################################################

### 5.1 Block IP Manually (Test IP 1)
POST {{baseUrl}}/api/v1/mitigation/block/203.0.113.99?reason=Manual%20test%20blocking
Content-Type: application/json

### 5.2 Block IP Manually (Test IP 2)
POST {{baseUrl}}/api/v1/mitigation/block/45.33.32.156?reason=Suspected%20DDoS%20attack
Content-Type: application/json

### 5.3 Block IP Manually (Test IP 3)
POST {{baseUrl}}/api/v1/mitigation/block/198.51.100.50?reason=High%20traffic%20volume
Content-Type: application/json

### 5.4 Check If IP is Blocked (Test IP 1)
GET {{baseUrl}}/api/v1/mitigation/is-blocked/203.0.113.99
Accept: application/json

### 5.5 Check If IP is Blocked (Test IP 2)
GET {{baseUrl}}/api/v1/mitigation/is-blocked/45.33.32.156
Accept: application/json

### 5.6 Check If Safe IP is Blocked
GET {{baseUrl}}/api/v1/mitigation/is-blocked/192.168.1.1
Accept: application/json

### 5.7 List All Blocked IPs
GET {{baseUrl}}/api/v1/mitigation/blocked
Accept: application/json

### 5.8 Get Mitigation Statistics
GET {{baseUrl}}/api/v1/mitigation/stats
Accept: application/json


###############################################################################
# 6. MITIGATION - Unblocking
###############################################################################

### 6.1 Unblock IP (Test IP 1)
POST {{baseUrl}}/api/v1/mitigation/unblock/203.0.113.99
Content-Type: application/json

### 6.2 Unblock IP (Test IP 2)
POST {{baseUrl}}/api/v1/mitigation/unblock/45.33.32.156
Content-Type: application/json

### 6.3 Unblock IP (Test IP 3)
POST {{baseUrl}}/api/v1/mitigation/unblock/198.51.100.50
Content-Type: application/json

### 6.4 Verify Unblocking (Check IP 1)
GET {{baseUrl}}/api/v1/mitigation/is-blocked/203.0.113.99
Accept: application/json


###############################################################################
# 7. SECURITY DASHBOARD
###############################################################################

### 7.1 Get Security Dashboard
GET {{baseUrl}}/api/v1/security/dashboard
Accept: application/json

### 7.2 Get System Status
GET {{baseUrl}}/api/v1/security/status
Accept: application/json

### 7.3 Manually Trigger Detection
POST {{baseUrl}}/api/v1/security/trigger-detection
Content-Type: application/json

### 7.4 Analyze Specific IP
POST {{baseUrl}}/api/v1/security/analyze/203.0.113.99
Content-Type: application/json

### 7.5 Test Alert System
POST {{baseUrl}}/api/v1/security/test-alert
Content-Type: application/json


###############################################################################
# 8. COMPLETE TEST SCENARIOS
###############################################################################

### 8.1 SCENARIO: Normal Traffic Flow
# Step 1: Ingest normal traffic
POST {{baseUrl}}/api/v1/traffic/ingest
Content-Type: application/json

{
  "sourceIp": "192.168.10.100",
  "destinationIp": "10.0.0.1",
  "packetCount": 800,
  "byteCount": 51200
}

### 8.2 Step 2: Check if classified as attack
POST {{baseUrl}}/api/v1/traffic/predict-attack
Content-Type: application/json

{
  "sourceIp": "192.168.10.100",
  "destinationIp": "10.0.0.1",
  "packetCount": 800,
  "byteCount": 51200
}

### 8.3 Step 3: Verify IP is not blocked
GET {{baseUrl}}/api/v1/mitigation/is-blocked/192.168.10.100
Accept: application/json


### 8.4 SCENARIO: Attack Detection & Auto-Blocking
# Step 1: Ingest attack traffic
POST {{baseUrl}}/api/v1/traffic/ingest
Content-Type: application/json

{
  "sourceIp": "203.0.113.200",
  "destinationIp": "10.0.0.1",
  "packetCount": 180000,
  "byteCount": 11520000
}

### 8.5 Step 2: Check ML prediction
POST {{baseUrl}}/api/v1/traffic/predict-attack
Content-Type: application/json

{
  "sourceIp": "203.0.113.200",
  "destinationIp": "10.0.0.1",
  "packetCount": 180000,
  "byteCount": 11520000
}

### 8.6 Step 3: Wait 35 seconds, then check if auto-blocked
# NOTE: Wait 35 seconds after Step 1 before running this
GET {{baseUrl}}/api/v1/mitigation/is-blocked/203.0.113.200
Accept: application/json

### 8.7 Step 4: Check security dashboard
GET {{baseUrl}}/api/v1/security/dashboard
Accept: application/json


### 8.8 SCENARIO: Manual IP Management
# Step 1: Block a test IP
POST {{baseUrl}}/api/v1/mitigation/block/198.51.100.123?reason=Manual%20test
Content-Type: application/json

### 8.9 Step 2: Verify it's blocked
GET {{baseUrl}}/api/v1/mitigation/is-blocked/198.51.100.123
Accept: application/json

### 8.10 Step 3: Check blocked list
GET {{baseUrl}}/api/v1/mitigation/blocked
Accept: application/json

### 8.11 Step 4: Unblock the IP
POST {{baseUrl}}/api/v1/mitigation/unblock/198.51.100.123
Content-Type: application/json

### 8.12 Step 5: Verify it's unblocked
GET {{baseUrl}}/api/v1/mitigation/is-blocked/198.51.100.123
Accept: application/json


