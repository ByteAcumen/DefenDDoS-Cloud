###############################################################################
# 10. EDGE CASES & VALIDATION
###############################################################################

### 10.1 Test Invalid IP Format
POST {{baseUrl}}/api/v1/traffic/ingest
Content-Type: application/json

{
  "sourceIp": "999.999.999.999",
  "destinationIp": "10.0.0.1",
  "packetCount": 100,
  "byteCount": 6400
}

### 10.2 Test Negative Packet Count (Should fail validation)
POST {{baseUrl}}/api/v1/traffic/ingest
Content-Type: application/json

{
  "sourceIp": "192.168.1.1",
  "destinationIp": "10.0.0.1",
  "packetCount": -100,
  "byteCount": 6400
}

### 10.3 Test Zero Traffic (Edge case)
POST {{baseUrl}}/api/v1/traffic/ingest
Content-Type: application/json

{
  "sourceIp": "192.168.1.1",
  "destinationIp": "10.0.0.1",
  "packetCount": 0,
  "byteCount": 0
}

### 10.4 Test Very Large Packet Count
POST {{baseUrl}}/api/v1/traffic/ingest
Content-Type: application/json

{
  "sourceIp": "203.0.113.250",
  "destinationIp": "10.0.0.1",
  "packetCount": 999999999,
  "byteCount": 999999999999
}


###############################################################################
# 11. MONITORING & METRICS
###############################################################################

### 11.1 Get All Metrics
GET {{baseUrl}}/actuator/metrics
Accept: application/json

### 11.2 Check JVM Memory
GET {{baseUrl}}/actuator/metrics/jvm.memory.used
Accept: application/json

### 11.3 Check HTTP Requests Count
GET {{baseUrl}}/actuator/metrics/http.server.requests
Accept: application/json


###############################################################################
# TEST RESULTS EXPECTATIONS
###############################################################################

# ✅ NORMAL TRAFFIC (192.168.x.x, <10000 packets):
#    - is_attack: false
#    - confidence: <50%
#    - severity: NORMAL or LOW
#    - should_block: false
#    - IP NOT auto-blocked

# ⚠️ MEDIUM RISK (50000-100000 packets):
#    - is_attack: true/false (depends on other features)
#    - confidence: 40-70%
#    - severity: MEDIUM
#    - should_block: true/false
#    - May or may not be auto-blocked

# 🚨 HIGH RISK (>125000 packets):
#    - is_attack: true
#    - confidence: 70-100%
#    - severity: HIGH or CRITICAL
#    - should_block: true
#    - IP auto-blocked within 30 seconds

# 📊 AUTO-DETECTION:
#    - Runs every 30 seconds
#    - Checks last 60 seconds of traffic
#    - Blocks IPs with confidence ≥50% OR anomaly score >100
#    - Check logs: "Starting automatic attack detection"

###############################################################################
# END OF TEST SUITE
###############################################################################
