###
# DefenDDoS Backend API Testing
# Make sure services are running: docker-compose up -d
###

@baseUrl = http://localhost:8082
@auth = Basic YWRtaW46RGVmZW5ERG9TMTIzIQ==

### Test 1: Health Check
GET {{baseUrl}}/actuator/health
Authorization: {{auth}}
Host: localhost:8082

###

### Test 2: Security Dashboard
GET {{baseUrl}}/api/v1/security/dashboard
Authorization: {{auth}}
Host: localhost:8082

###

### Test 3: Mitigation Status
GET {{baseUrl}}/api/v1/mitigation/status
Authorization: {{auth}}
Host: localhost:8082

###

### Test 4: Send Normal Traffic
POST {{baseUrl}}/api/v1/traffic/ingest
Authorization: {{auth}}
Content-Type: application/json
Host: localhost:8082

{
  "sourceIp": "192.168.1.100",
  "destinationIp": "10.0.0.50",
  "packetCount": 500,
  "byteCount": 250000
}

###

### Test 5: Send LOW Threat Traffic
POST {{baseUrl}}/api/v1/traffic/ingest
Authorization: {{auth}}
Content-Type: application/json
Host: localhost:8082

{
  "sourceIp": "203.0.113.10",
  "destinationIp": "10.0.0.50",
  "packetCount": 1500,
  "byteCount": 750000
}

###

### Test 6: Send MEDIUM Threat Traffic
POST {{baseUrl}}/api/v1/traffic/ingest
Authorization: {{auth}}
Content-Type: application/json
Host: localhost:8082

{
  "sourceIp": "203.0.113.20",
  "destinationIp": "10.0.0.50",
  "packetCount": 8000,
  "byteCount": 4000000
}

###

### Test 7: Send HIGH Threat Traffic (Auto-Block)
POST {{baseUrl}}/api/v1/traffic/ingest
Authorization: {{auth}}
Content-Type: application/json
Host: localhost:8082

{
  "sourceIp": "203.0.113.30",
  "destinationIp": "10.0.0.50",
  "packetCount": 20000,
  "byteCount": 10000000
}

###

### Test 8: Send CRITICAL Threat Traffic (Immediate Block)
POST {{baseUrl}}/api/v1/traffic/ingest
Authorization: {{auth}}
Content-Type: application/json
Host: localhost:8082

{
  "sourceIp": "203.0.113.99",
  "destinationIp": "10.0.0.50",
  "packetCount": 60000,
  "byteCount": 30000000
}

###

### Test 9: Check Recent Traffic
GET {{baseUrl}}/api/v1/traffic/query?minutes=60
Authorization: {{auth}}
Host: localhost:8082

###

### Test 10: View Blocked IPs
GET {{baseUrl}}/api/v1/mitigation/blocked
Authorization: {{auth}}
Host: localhost:8082

###

### Test 11: Check Specific IP Status
GET {{baseUrl}}/api/v1/mitigation/check/203.0.113.99
Authorization: {{auth}}
Host: localhost:8082

###

### Test 12: Manual Block IP
POST {{baseUrl}}/api/v1/mitigation/block/203.0.113.88?reason=Manual+Test
Authorization: {{auth}}
Host: localhost:8082

###

### Test 13: Check Manual Block Status
GET {{baseUrl}}/api/v1/mitigation/check/203.0.113.88
Authorization: {{auth}}
Host: localhost:8082

###

### Test 14: Unblock IP
POST {{baseUrl}}/api/v1/mitigation/unblock/203.0.113.88
Authorization: {{auth}}
Host: localhost:8082

