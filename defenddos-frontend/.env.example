# DefenDDoS Cloud - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to Git!

# ============================================
# Backend API Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_ML_URL=http://localhost:8000

# API Key for backend authentication
NEXT_PUBLIC_API_KEY=your-secure-api-key-here

# ============================================
# JWT Configuration (Server-side only)
# ============================================
# Must be at least 32 characters long
JWT_SECRET=your-jwt-secret-min-32-characters-long
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ============================================
# OAuth - Google
# ============================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# OAuth - GitHub
# ============================================
NEXT_PUBLIC_GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Security Settings
# ============================================
# Enable/disable demo mode for development
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# Session timeout in minutes
SESSION_TIMEOUT=30

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
